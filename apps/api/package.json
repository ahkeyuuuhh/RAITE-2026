{
  "name": "@classassist/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../../.env src/server.js",
    "worker": "node --env-file-if-exists=../../.env src/worker.js",
    "test": "node --test test/domain.test.js",
    "test:integration": "node --env-file-if-exists=../../.env --test --test-concurrency=1 test/integration.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "supertest": "7.3.0"
  }
}
