{
  "expo": {
    "name": "ClassAssist",
    "slug": "classassist",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "classassist",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raite.classassist"
    },
    "android": {
      "package": "com.raite.classassist"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aider to choose a profile photo from your library.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "description": "Room for learning. Student AI tutor companion."
    }
  }
}
