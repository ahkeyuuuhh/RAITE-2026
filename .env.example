# Local Supabase: run npx supabase start, then copy its local values here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
# Used ONLY by the seed script to create synthetic Auth accounts.
SUPABASE_SECRET_KEY=
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:8082
# Any OpenAI-compatible chat-completions provider. Keep credentials server-side.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Local development only. A saved sample draft is visibly labeled, never live AI.
ALLOW_SAMPLE_DRAFTS=true
SEED_PASSWORD=

# Google Calendar: Web application OAuth client, server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/oauth/google-calendar/callback
# Generate 32 random bytes as 64 hex characters. Keep stable; back up securely.
GOOGLE_CALENDAR_TOKEN_KEY=
